# Copie para config/.env e preencha. Opções avançadas: ver README.

# Conta de e-mail que o robô monitora (use senha de aplicativo)
IMAP_SERVER=imap.seuprovedor.com
SMTP_SERVER=smtp.seuprovedor.com
EMAIL_USER=seu_email@empresa.com
EMAIL_PASS=sua_senha_de_app

# Chave da IA - https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxx

# false = a IA decide o encaminhamento de qualquer e-mail
# true  = só encaminha e-mails com palavras-chave do regras.json
REQUIRE_KEYWORDS_TO_FORWARD=true

# Só considera e-mails recebidos a partir desta data (DD/MM/AAAA HH:MM).
# Use "agora" para valer o momento da primeira execução do robô.
CUTOFF_DATE=agora
